<?xml version="1.0" encoding="utf-8"?>
<!--
  The app talks to the outside world over TLS only. Cleartext is permitted for exactly one reason:
  the in-process loopback origin that serves the bundled web app lives on 127.0.0.1, and WebView
  fetches it directly. No remote host may ever be reached over cleartext.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>